---
import { Image } from 'astro:assets';
import heroImg from '../assets/images/hero/hero.jpg';
import Button from '../components/Button.astro';
---

<section id="hero" class="relative min-h-screen flex flex-col overflow-hidden">

  <!-- Background image -->
  <Image
    src={heroImg}
    alt="MDI team on a construction site"
    class="absolute inset-0 w-full h-full object-cover object-center"
    loading="eager"
    fetchpriority="high"
    widths={[375, 768, 1280, 1920]}
    sizes="100vw"
    quality={85}
  />

  <!-- Green overlay -->
  <div class="absolute inset-0 bg-brand-green/60"></div>

  <!-- Content -->
  <div class="relative z-10 flex-1 flex flex-col justify-end px-5 md:px-10 lg:px-20 pb-16 md:pb-20 lg:pb-28 pt-28 lg:pt-36">
    <div class="max-w-[1280px] mx-auto w-full">

      <!-- Headline + CTA -->
      <div class="lg:max-w-[640px]">
        <h1 class="font-display text-[52px] md:text-[72px] lg:text-[96px] leading-none tracking-tight uppercase mb-6 lg:mb-8">
          <span class="text-white block">Build Smarter.</span>
          <span class="text-brand-gold block">Scale Faster.</span>
        </h1>

        <!-- TODO: client to confirm hero subtext -->
        <p class="text-white text-base md:text-lg font-sans leading-relaxed max-w-[480px] mb-8 lg:mb-10">
          Eight to twelve workers. Two weeks of schedule. A crew of two to four operators can now do it in five days.
        </p>

        <Button href="#what-we-do" fullWidthMobile={true}>Learn More</Button>
      </div>

    </div>
  </div>

</section>
