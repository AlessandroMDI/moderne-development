---
import { Image } from 'astro:assets';
import heroImg from '../assets/images/hero/hero.jpg';
---

<section id="hero" class="relative min-h-screen flex flex-col overflow-hidden">

  <!-- Background image -->
  <Image
    src={heroImg}
    alt="MDI team on a construction site"
    class="absolute inset-0 w-full h-full object-cover object-center"
    loading="eager"
    fetchpriority="high"
    widths={[375, 768, 1280, 1920]}
    sizes="100vw"
    quality={85}
  />

  <!-- Forest overlay -->
  <div class="absolute inset-0" style="background:rgba(26,74,58,0.62)"></div>

  <!-- Dot grid texture -->
  <div class="absolute inset-0 hero-dots"></div>

  <!-- Content — vertically centered -->
  <div class="relative z-10 flex-1 flex flex-col justify-center px-5 md:px-10 lg:px-20 pt-24 pb-16">
    <div class="max-w-[800px] mx-auto w-full text-center">

      <h1 class="hero-h1 mb-6">
        <span class="block text-white hero-ln hero-a1">Build Smarter.</span>
        <span class="block hero-ln hero-a2" style="color:#D4A843">Scale Faster.</span>
      </h1>


      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 hero-btns">
        <a
          href="#what-we-do"
          style="font-family:var(--site-font);background:#fff;color:var(--dark);padding:13px 32px;border-radius:6px;font-size:14px;font-weight:500;text-decoration:none;transition:opacity 150ms;display:inline-flex;align-items:center"
          onmouseover="this.style.opacity='0.9'"
          onmouseout="this.style.opacity='1'"
        >
          Learn More
        </a>
        <button
          data-contact-trigger
          style="font-family:var(--site-font);background:#fff;color:var(--dark);padding:13px 32px;border-radius:6px;font-size:14px;font-weight:500;border:none;cursor:pointer;transition:opacity 150ms"
          onmouseover="this.style.opacity='0.9'"
          onmouseout="this.style.opacity='1'"
        >
          Work With Us
        </button>
      </div>

    </div>
  </div>

</section>

<style>
  @keyframes heroSlideUp {
    to { transform: translateY(0); opacity: 1; }
  }
  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-h1 {
    font-family: var(--site-font);
    font-size: clamp(44px, 7vw, 80px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    overflow: hidden;
  }

  .hero-ln {
    transform: translateY(110%);
    opacity: 0;
  }
  .hero-a1 { animation: heroSlideUp 0.85s cubic-bezier(0.16,1,0.3,1) 0.3s both; }
  .hero-a2 { animation: heroSlideUp 0.85s cubic-bezier(0.16,1,0.3,1) 0.45s both; }
  .hero-sub  { opacity: 0; animation: heroFadeUp 0.9s 0.78s both; }
  .hero-btns { opacity: 0; animation: heroFadeUp 0.9s 0.95s both; }

  .hero-dots {
    background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1px);
    background-size: 28px 28px;
  }
</style>
