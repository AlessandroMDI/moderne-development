---
import { Image } from 'astro:assets';
import commercialImg from '../assets/images/projects/commercial.jpg';
import residentialImg from '../assets/images/projects/clarksville.jpg';
import multiUnitImg from '../assets/images/projects/multi-unit.jpg';

const categories = [
  {
    id: 'commercial',
    label: 'Commercial',
    title: 'Commercial',
    img: commercialImg,
    imgAlt: 'Commercial development project',
    body: [
      'We design and deliver commercial spaces built around how businesses actually operate — not how they operated a decade ago. Advanced robotics, 3D concrete printing, and digital construction methods let us build faster and with tighter structural tolerances than conventional site work allows.',
      'Modern Methods of Construction (MMC) cut delays and reduce material waste without sacrificing performance. Commercial developments built through this process are more durable, easier to phase, and significantly cheaper to deliver at scale.',
      "Office environments, mixed-use hubs, retail — the category doesn't change the approach. The process is the same. So are the results.",
    ],
  },
  {
    id: 'residential',
    label: 'Residential',
    title: 'Residential',
    img: residentialImg,
    imgAlt: 'Residential development project',
    imgPosition: '45% center',
    body: [
      "We build homes using advanced robotics, automated building systems, and 3D concrete printing. The technology isn't the point — the output is. Homes built through this process are more precise, take less time to complete, and perform better structurally than most site-built alternatives.",
      "MMC reduces material waste and allows for tighter tolerances at every stage of construction. We design for durability from the start, not as an afterthought.",
      "The people who will live in these homes aren't thinking about the construction method. They shouldn't have to. That's what we handle.",
    ],
  },
  {
    id: 'multi-unit',
    label: 'Multi-Unit',
    title: 'Multi-Unit',
    img: multiUnitImg,
    imgAlt: 'Multi-unit development project',
    imgPosition: '42% center',
    body: [
      'Multi-family housing puts everything under pressure — cost, schedule, structural performance, and density requirements. We address all of it through robotics, automated construction systems, and 3D concrete printing integrated directly into the build process.',
      'Digital construction and Modern Methods of Construction (MMC) allow us to move faster without trading off structural quality. The result is multi-family buildings that perform well and cost less to deliver.',
      "We're building communities people actually want to live in. The density gets handled. So does the durability.",
    ],
  },
];
---

<section id="projects" class="scroll-mt-14 lg:scroll-mt-16" style="background:var(--bg1)">
  <div class="site-inner">

    <!-- Section header -->
    <div class="mb-10 lg:mb-14">
      <span class="site-lbl block mb-4">Our Projects</span>
      <div class="md:flex md:items-end md:justify-between md:gap-6">
        <div>
          <h2 class="site-sh">
            Projects Powered by <span style="color:#b8952a">MDI.</span>
          </h2>
          <p class="site-sp mt-4">
            Actively delivering projects across the US and UK — validating the platform in real-world conditions.
          </p>
        </div>
        <a href="/projects" class="site-btn-p mt-6 md:mt-0 shrink-0">
          See Our Projects
        </a>
      </div>
    </div>

    <!-- Card grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="projects-grid">
      {categories.map((cat) => (
        <button
          class="project-card relative overflow-hidden rounded-xl cursor-pointer group text-left focus:outline-none"
          style="background:var(--bg1)"
          aria-expanded="false"
          data-card={cat.id}
        >
          <div class="relative overflow-hidden">
            <Image
              src={cat.img}
              alt={cat.imgAlt}
              widths={[375, 640, 960]}
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="lazy"
              quality={80}
              class="w-full aspect-[3/4] object-cover transition-transform duration-700 group-hover:scale-[1.04]"
              style={cat.imgPosition ? `object-position: ${cat.imgPosition}` : undefined}
            />
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 via-[15%] to-transparent"></div>
            <!-- indicator element kept for JS compatibility — visual handled via CSS on aria-expanded -->
            <div class="project-card-indicator hidden"></div>
            <!-- Label text -->
            <div class="absolute bottom-0 left-0 p-5 lg:p-7">
              <span class="block leading-none text-white proj-label">{cat.title}</span>
            </div>
          </div>
        </button>
      ))}
    </div>

    <!-- Content panels wrapper — height animates once on open/close; switching panels is a fade only -->
    <div id="projects-panel-wrap" class="projects-wrap rounded-xl">
      {categories.map((cat) => (
        <div class="project-content" data-content={cat.id}>
          <div class="bg-brand-green flex gap-8 lg:gap-12 px-8 py-10 lg:px-12 lg:py-12"
               style="background:var(--bg2);min-height:220px">
            <div class="w-px flex-shrink-0 self-stretch" style="background:var(--green)"></div>
            <div>
              {cat.body.map((para) => (
                <p class="mb-4 last:mb-0" style="font-family:var(--site-font);font-size:15px;line-height:1.75;color:var(--muted)">{para}</p>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- Mobile popup modal — bg-brand-green class kept as JS hook -->
<div id="project-modal" class="fixed inset-0 z-50 hidden md:hidden" aria-modal="true" role="dialog">
  <div id="modal-backdrop" class="absolute inset-0 bg-black/60"></div>
  <div class="bg-brand-green absolute bottom-0 left-0 right-0 max-h-[78vh] flex flex-col"
       style="background:var(--bg1)">
    <div class="flex-shrink-0 flex items-center justify-between px-8 pt-8 pb-6"
         style="border-bottom:1px solid var(--bdr)">
      <h3 id="modal-title" class="leading-none proj-label" style="color:var(--dark)"></h3>
      <button id="modal-close" aria-label="Close" class="p-1 -mr-1 transition-colors"
              style="color:var(--muted)" onmouseover="this.style.color=`var(--dark)`" onmouseout="this.style.color=`var(--muted)`">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="px-8 pt-8 pb-16 overflow-y-auto flex-1">
      <div id="modal-body"></div>
    </div>
  </div>
</div>

<style>
  .proj-label {
    font-family: var(--site-font);
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .project-card {
    transition: box-shadow 150ms;
  }
  .project-card[aria-expanded="true"] {
    box-shadow: 0 0 0 4px white, 0 0 0 7px var(--green);
  }

  /* Wrapper handles height — only animates when going from 0→open or open→0 */
  .projects-wrap {
    overflow: hidden;
    max-height: 0;
    transition: max-height 420ms cubic-bezier(0.4, 0, 0.2, 1),
                margin-top 420ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .projects-wrap.has-open {
    max-height: 600px;
    margin-top: 1rem;
  }

  /* Individual panels just fade — no height change when switching */
  .project-content {
    display: none;
  }
  .project-content.is-open {
    display: block;
    animation: projFadeIn 220ms ease;
  }
  @keyframes projFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const grid = document.getElementById('projects-grid');
  const panelWrap = document.getElementById('projects-panel-wrap');
  const modal = document.getElementById('project-modal') as HTMLElement | null;
  const modalTitle = document.getElementById('modal-title') as HTMLElement | null;
  const modalBody = document.getElementById('modal-body') as HTMLElement | null;
  const modalClose = document.getElementById('modal-close');
  const modalBackdrop = document.getElementById('modal-backdrop');

  function closeModal() {
    modal?.classList.add('hidden');
    document.body.style.overflow = '';
    grid?.querySelectorAll('[data-card]').forEach(c => {
      c.setAttribute('aria-expanded', 'false');
    });
  }

  modalClose?.addEventListener('click', closeModal);
  modalBackdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  if (grid) {
    let openId: string | null = null;

    grid.addEventListener('click', (e) => {
      const card = (e.target as Element).closest('[data-card]') as HTMLElement | null;
      if (!card) return;

      const id = card.dataset.card!;

      if (window.innerWidth < 768) {
        // Mobile: show popup
        const content = document.querySelector(`[data-content="${id}"]`) as HTMLElement | null;
        const parasDiv = content?.querySelector('.bg-brand-green > div:last-child');
        if (modalBody) modalBody.innerHTML = parasDiv?.innerHTML ?? '';
        if (modalTitle) {
          const labelEl = card.querySelector('.proj-label');
          modalTitle.textContent = labelEl?.textContent ?? '';
        }
        modal?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        card.setAttribute('aria-expanded', 'true');
        return;
      }

      // Desktop: accordion
      const content = document.querySelector(`[data-content="${id}"]`) as HTMLElement | null;

      if (openId && openId !== id) {
        // Switching panels: just swap content — wrapper height stays, no layout shift
        const prevContent = document.querySelector(`[data-content="${openId}"]`) as HTMLElement | null;
        const prevCard = grid.querySelector(`[data-card="${openId}"]`) as HTMLElement | null;
        prevContent?.classList.remove('is-open');
        prevCard?.setAttribute('aria-expanded', 'false');
        content?.classList.add('is-open');
        card.setAttribute('aria-expanded', 'true');
        openId = id;
        return;
      }

      const isOpen = content?.classList.contains('is-open');
      if (isOpen) {
        // Closing: animate wrapper height to 0
        content?.classList.remove('is-open');
        card.setAttribute('aria-expanded', 'false');
        panelWrap?.classList.remove('has-open');
        openId = null;
      } else {
        // Opening from closed: animate wrapper height in
        content?.classList.add('is-open');
        card.setAttribute('aria-expanded', 'true');
        panelWrap?.classList.add('has-open');
        openId = id;
      }
    });
  }
</script>
