---
import { Image } from 'astro:assets';
import teamImg from '../assets/images/team/full-team.jpg';
import Ticker from '../components/Ticker.astro';

const features = [
  {
    title: 'AI-Driven Land & Feasibility',
    body: 'Automated screening of real estate opportunities, zoning constraints, and project viability before a dollar moves.',
  },
  {
    title: 'Digital Twin & BIM Automation',
    body: 'AEC-ready BIM files, cost estimation, engineering specs, and regulatory compliance — auto-generated.',
  },
  {
    title: 'Developer-Led Execution',
    body: 'We JV with builders early, validating designs and technology in the field. Not in a conference room.',
  },
];
---

<section id="what-we-do" class="scroll-mt-14 lg:scroll-mt-16" style="background:var(--bg2)">
  <Ticker />

  <div class="site-inner">
    <div class="wwd-grid">

      <!-- Left: image card -->
      <div class="wwd-imgbox">
        <Image
          src={teamImg}
          alt="The MDI team"
          loading="lazy"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      </div>

      <!-- Right: content -->
      <div class="flex flex-col justify-center">

        <span class="site-lbl block mb-4">What We Do</span>

        <h2 class="site-sh mb-6 lg:mb-8">
          The Operating System<br />for Modern Construction.
        </h2>

        <p style="font-family:var(--site-font);font-size:15px;line-height:1.75;color:var(--muted);max-width:520px;margin-bottom:2rem">
          MDI develops MDOS, a platform that connects AI-enabled robotics, 5D-BIM automation, proven building systems, and the people who actually build. We partner directly with developers and builders. Projects run faster and finish closer to plan.
        </p>

        <!-- Feature cards -->
        <div class="flex flex-col gap-3">
          {features.map(f => (
            <div class="site-card">
              <h3 style="font-family:var(--site-font);font-size:14px;font-weight:600;color:var(--dark);margin-bottom:6px">{f.title}</h3>
              <p style="font-family:var(--site-font);font-size:13px;line-height:1.7;color:var(--muted)">{f.body}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .wwd-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  @media (max-width: 900px) {
    .wwd-grid { grid-template-columns: 1fr; gap: 40px; }
  }

  .wwd-imgbox {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    height: 480px;
    border: 1px solid var(--bdr);
  }
  @media (max-width: 900px) {
    .wwd-imgbox { height: 280px; }
  }
  .wwd-imgbox img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.5s;
  }
  .wwd-imgbox:hover img { transform: scale(1.02); }

</style>
