---
import { Icon } from 'astro-icon/components';

const audiences = [
  {
    icon: 'lucide:building-2',
    title: 'Real Estate Developers',
    body: 'Developers need speed without losing control. MDOS takes a project from land screening to build-ready BIM in a single pipeline: AI feasibility analysis, automated cost estimates, robotic construction sequences. All of it generated before a shovel hits the ground.',
  },
  {
    icon: 'lucide:wrench',
    title: 'Contractors & Builders',
    body: 'Builders who partner with MDI get BIM files that translate directly into robotic print sequences and prefab specifications. No re-authoring between design and construction. What used to require eight to twelve workers over two weeks now takes two to four operators in five days.',
  },
  {
    icon: 'lucide:landmark',
    title: 'Institutional Partners',
    body: 'Housing agencies, government programs, and institutional investors who need residential delivery at volume. MDI\'s "Design Once, Deploy Many" model means thousands of units can move forward without rebuilding the process each time.',
  },
];
---

<section id="who-we-serve" class="scroll-mt-14 lg:scroll-mt-16" style="background:var(--bg1)">
  <div class="site-inner">

    <!-- Section header: two-column on lg -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-20 mb-14 lg:mb-20">

      <div>
        <span class="site-lbl block mb-4">Who We Serve</span>
        <h2 class="site-sh">
          Built for the People<br />
          <span style="color:#b8952a">Who Build.</span>
        </h2>
      </div>

      <div class="lg:pt-2 flex flex-col justify-center">
        <p class="site-sp">
          MDI works across the full chain: developers who control the land, builders running the site, and institutional partners moving at volume. The platform is built around their actual constraints, not a product looking for a use case.
        </p>
      </div>

    </div>

    <!-- Audience cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {audiences.map((a) => (
        <div class="site-card">

          <div class="mb-4" style="color:var(--green)">
            <Icon name={a.icon} class="w-7 h-7" />
          </div>

          <h3 style="font-family:var(--site-font);font-size:16px;font-weight:600;color:var(--dark);margin-bottom:10px;line-height:1.3">{a.title}</h3>

          <p style="font-family:var(--site-font);font-size:14px;line-height:1.75;color:var(--muted)">{a.body}</p>

        </div>
      ))}
    </div>

  </div>
</section>
