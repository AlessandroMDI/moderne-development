---
const capabilities = [
  {
    num: '01',
    title: 'AI Land & Feasibility Screening',
    body: 'MDOS scans parcels for zoning compliance, development potential, and project feasibility before a dollar is committed.',
  },
  {
    num: '02',
    title: '5D BIM & Cost Automation',
    body: 'A site-adaptable design library auto-generates AEC-ready BIM files, cost estimates, and engineering specs via VERTIKAAL.',
  },
  {
    num: '03',
    title: 'Robotic Code Generation',
    body: 'MDOS translates BIM directly into robotic print sequences for 3D concrete systems: ICON, Printerra, and Liberty3D. No manual re-authoring.',
  },
  {
    num: '04',
    title: 'Prefab & Modular Workflows',
    body: 'Tunnel-form, SCIP panel, and modular construction sequences are generated from the same design input. One BIM, many build paths.',
  },
  {
    num: '05',
    title: 'Digital Twin Generation',
    body: 'Every MDOS project produces a live digital twin for active monitoring, ongoing iteration, and redeployment across future projects.',
  },
  {
    num: '06',
    title: 'Design Once, Deploy Many',
    body: 'Validated MDOS builds are redeployable across markets, geographies, and project types. The designs, workflows, and robotic code carry over.',
  },
];
---

<section id="platform" class="scroll-mt-14 lg:scroll-mt-16" style="background:var(--bg1)">
  <div class="site-inner">

    <!-- Section header -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-20 mb-14 lg:mb-20">

      <div>
        <span class="site-lbl block mb-4">MDOS</span>
        <h2 class="site-sh">
          One System.<br />
          <span style="color:#b8952a">Every Stage</span> of the Build.
        </h2>
      </div>

      <div class="lg:pt-1 flex flex-col justify-between gap-8">
        <div>
          <p class="site-lbl mb-3">MDI Operating System</p>
          <p class="site-sp">
            MDOS is MDI's proprietary platform connecting AI-driven site analysis, automated BIM, and robotic construction into a single pipeline. Not a tool you buy or license. It is the operating layer MDI deploys on every project, from land acquisition to final delivery.
          </p>
        </div>
        <div>
          <a href="/platform" class="site-btn-p">Explore MDOS</a>
        </div>
      </div>

    </div>

    <!-- Capabilities label -->
    <div class="mb-8">
      <span class="site-lbl">Platform Capabilities</span>
    </div>

    <!-- Capabilities: flat cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {capabilities.map((cap) => (
        <div class="site-card">
          <div class="flex items-start gap-3 mb-3">
            <span style="font-family:var(--site-font);font-size:11px;font-weight:600;letter-spacing:0.06em;color:var(--green);padding-top:3px;flex-shrink:0">{cap.num}</span>
            <h3 style="font-family:var(--site-font);font-size:14px;font-weight:600;color:var(--dark);line-height:1.4">{cap.title}</h3>
          </div>
          <p style="font-family:var(--site-font);font-size:13px;line-height:1.7;color:var(--muted)">{cap.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>
