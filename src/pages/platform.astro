---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';

const capabilities = [
  {
    num: '01',
    title: 'AI Land & Feasibility Screening',
    body: 'MDOS scans parcels for zoning compliance, development potential, and project feasibility before a dollar is committed.',
  },
  {
    num: '02',
    title: '5D BIM & Cost Automation',
    body: 'A site-adaptable design library auto-generates AEC-ready BIM files, cost estimates, and engineering specs via VERTIKAAL.',
  },
  {
    num: '03',
    title: 'Robotic Code Generation',
    body: 'MDOS translates BIM directly into robotic print sequences for 3D concrete systems: ICON, Printerra, and Liberty3D. No manual re-authoring.',
  },
  {
    num: '04',
    title: 'Prefab & Modular Workflows',
    body: 'Tunnel-form, SCIP panel, and modular construction sequences are generated from the same design input. One BIM, many build paths.',
  },
  {
    num: '05',
    title: 'Digital Twin Generation',
    body: 'Every MDOS project produces a live digital twin for active monitoring, ongoing iteration, and redeployment across future projects.',
  },
  {
    num: '06',
    title: 'Design Once, Deploy Many',
    body: 'Validated MDOS builds are redeployable across markets, geographies, and project types. The designs, workflows, and robotic code carry over.',
  },
];
---

<Layout
  title="MDOS — MDI Platform | Moderne Development"
  description="MDOS is MDI's proprietary operating platform — connecting AI-driven site analysis, automated BIM, and robotic construction into a single end-to-end pipeline."
>
  <Navbar />

  <!-- Page Header -->
  <section class="bg-surface-cream px-5 md:px-10 lg:px-20 pt-14 lg:pt-16">
    <div class="max-w-[1280px] mx-auto pt-16 pb-14 md:pt-20 md:pb-16 lg:pt-24 lg:pb-20">

      <!-- Back nav -->
      <a
        href="/"
        class="inline-flex items-center gap-2 font-sans text-xs font-medium tracking-widest uppercase text-text-secondary hover:text-text-primary transition-colors duration-200 mb-8 lg:mb-10"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Home
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-2 lg:grid-rows-[auto_1fr] gap-12 lg:gap-x-20 lg:gap-y-10">

        <h1 class="font-display text-[28px] md:text-[36px] lg:text-[48px] leading-tight tracking-tight uppercase text-text-primary lg:col-start-1 lg:row-start-1 lg:whitespace-nowrap">
          The <span class="text-brand-green">Operating Layer</span> Every Project Runs On
        </h1>

        <div class="lg:col-start-1 lg:row-start-2">
          <p class="font-sans text-base text-text-primary leading-relaxed mb-6">
            MDOS is not a tool MDI sells or licenses separately. It is the platform MDI is building and deploying on every project — the operating layer that connects land to delivery.
          </p>
          <p class="font-sans text-base text-text-primary leading-relaxed">
            Only developers can drive construction innovation at this level, because only developers control the full lifecycle. That is the differentiating argument — and MDOS is how MDI acts on it.
          </p>
        </div>

        <div class="flex flex-col gap-6 lg:col-start-2 lg:row-start-1 lg:row-span-2">

          <div class="border-t border-text-divider pt-6">
            <p class="font-sans text-xs font-medium tracking-widest uppercase text-text-secondary mb-2">Construction Methods</p>
            <ul class="font-sans text-sm text-text-primary leading-relaxed space-y-1">
              <li>3D Concrete Printing (3DCP)</li>
              <li>Prefabrication and tunnel-form construction</li>
              <li>Structural Concrete Insulated Panels (SCIP)</li>
              <li>Robotic parking infrastructure</li>
              <li>Fibre cement systems</li>
              <li>Modular building systems</li>
            </ul>
          </div>

          <div class="border-t border-text-divider pt-6">
            <p class="font-sans text-xs font-medium tracking-widest uppercase text-text-secondary mb-2">Robotics Partners</p>
            <p class="font-sans text-sm text-text-primary leading-relaxed">
              MDOS is technology-agnostic. It generates robotic code for ICON, Printerra, Liberty3D, and RIC Robotics — whichever system best fits the project.
            </p>
          </div>

          <div class="border-t border-text-divider pt-6">
            <p class="font-sans text-xs font-medium tracking-widest uppercase text-text-secondary mb-2">Defensible IP</p>
            <p class="font-sans text-sm text-text-primary leading-relaxed">
              Four utility patents filed. Ten in preparation. U.S. and international coverage.
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- Platform Capabilities -->
  <section class="bg-brand-green px-5 py-16 md:px-10 md:py-20 lg:px-20 lg:py-28">
    <div class="max-w-[1280px] mx-auto">

      <!-- Section label -->
      <div class="mb-10">
        <h2 class="font-display text-[28px] md:text-[32px] uppercase tracking-tight text-white">Platform Capabilities</h2>
      </div>

      <!-- Capabilities grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 overflow-visible pl-[6px] pb-[6px]">
        {capabilities.map((cap) => (
          <div class="card-3d-wrapper">
            <div class="card-3d-depth"></div>
            <div class="card-3d-left"></div>
            <div class="card-3d-bottom"></div>
            <div class="card-3d-face bg-brand-green border border-white/15 border-t-2 border-t-brand-gold p-6 lg:p-8">
              <div class="flex items-center gap-3 mb-4">
                <span class="font-display text-[18px] text-brand-gold leading-none shrink-0">{cap.num}</span>
                <h3 class="font-sans text-sm font-semibold text-white leading-snug">{cap.title}</h3>
              </div>
              <p class="font-sans text-sm text-white/80 leading-relaxed">{cap.body}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA strip -->
  <section class="bg-brand-green px-5 py-16 md:px-10 md:py-20 lg:px-20 lg:py-28">
    <div class="max-w-[1280px] mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-8">

      <h2 class="font-display text-[28px] md:text-[36px] lg:text-[44px] leading-tight tracking-tight uppercase text-white">
        See <span class="text-brand-gold">MDOS</span> in Action
      </h2>

      <button
        data-contact-trigger
        class="inline-flex items-center justify-center border border-white text-white font-sans text-xs font-semibold tracking-widest uppercase px-8 py-3 bg-transparent hover:bg-white hover:text-text-primary transition-colors duration-200 w-full sm:w-auto shrink-0"
      >
        Work With Us
      </button>

    </div>
  </section>

  <Footer />
  <ContactModal />

</Layout>
