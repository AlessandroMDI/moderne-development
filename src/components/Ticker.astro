---
const items = [
  'US Pilots Active — Austin TX & Canyon Lake',
  'UK Partnership — Barratt Redrow',
  'Build Partners: ICON · Instatiq · Printerra · Liberty3D',
  'MDOS — Operating System for the AEC Industry',
  'Design Once, Deploy Many',
  'Patents Filed: 4 + 10 in Preparation',
];
---

<div style="background:var(--bg1);border-top:1px solid var(--bdr);border-bottom:1px solid var(--bdr);overflow:hidden;white-space:nowrap">
  <div class="flex animate-marquee">
    {[...items, ...items].map((item) => (
      <span style="display:inline-flex;align-items:center;gap:20px;padding:10px 28px;font-family:var(--site-font);font-size:11px;letter-spacing:0.04em;color:var(--muted);flex-shrink:0">
        <span style="font-size:7px;color:var(--green);opacity:0.6">&#9670;</span>
        {item}
      </span>
    ))}
  </div>
</div>
