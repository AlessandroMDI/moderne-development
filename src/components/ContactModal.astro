---
---

<!-- Modal overlay — hidden by default, toggled via JS -->
<div
  id="contact-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Contact form"
  class="fixed inset-0 z-50 flex items-end sm:items-center justify-center hidden"
>
  <!-- Backdrop -->
  <div id="contact-backdrop" class="absolute inset-0" style="background:rgba(13,19,16,0.55);backdrop-filter:blur(2px)"></div>

  <!-- Panel -->
  <div
    class="relative w-full sm:max-w-[520px] sm:mx-4"
    id="contact-panel"
  >
    <!-- Mobile drag handle -->
    <div class="flex justify-center mb-5 sm:hidden">
      <div style="width:36px;height:4px;border-radius:2px;background:var(--bdr)"></div>
    </div>

    <!-- Close button -->
    <button
      id="contact-close"
      aria-label="Close contact form"
      class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center transition-colors duration-150"
      style="color:var(--muted);border-radius:6px"
      onmouseover="this.style.background='var(--bg2)';this.style.color='var(--dark)'"
      onmouseout="this.style.background='transparent';this.style.color='var(--muted)'"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M2 2L14 14M14 2L2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Header -->
    <div class="mb-6">
      <span class="site-lbl block mb-2">Get in Touch</span>
      <h2 style="font-family:var(--site-font);font-size:clamp(22px,3vw,28px);font-weight:600;letter-spacing:-0.02em;line-height:1.15;color:var(--dark)">
        Let's build something<br/>
        <span style="color:var(--green)">that lasts.</span>
      </h2>
    </div>

    <!-- Form -->
    <form
      name="contact"
      method="POST"
      netlify
      data-netlify="true"
      class="flex flex-col"
      style="gap:16px"
    >
      <input type="hidden" name="form-name" value="contact" />

      <!-- Name + Email row -->
      <div class="grid grid-cols-1 sm:grid-cols-2" style="gap:12px">
        <div class="flex flex-col" style="gap:5px">
          <label for="cf-name" style="font-family:var(--site-font);font-size:11px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:var(--muted)">Name</label>
          <input
            id="cf-name"
            type="text"
            name="name"
            required
            placeholder="Your name"
            style="font-family:var(--site-font);font-size:14px;color:var(--dark);background:var(--bg1);border:1px solid var(--bdr);border-radius:6px;height:42px;padding:0 12px;outline:none;transition:border-color 150ms"
            onfocus="this.style.borderColor='var(--green)'"
            onblur="this.style.borderColor='var(--bdr)'"
          />
        </div>
        <div class="flex flex-col" style="gap:5px">
          <label for="cf-email" style="font-family:var(--site-font);font-size:11px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:var(--muted)">Email</label>
          <input
            id="cf-email"
            type="email"
            name="email"
            required
            placeholder="you@company.com"
            style="font-family:var(--site-font);font-size:14px;color:var(--dark);background:var(--bg1);border:1px solid var(--bdr);border-radius:6px;height:42px;padding:0 12px;outline:none;transition:border-color 150ms"
            onfocus="this.style.borderColor='var(--green)'"
            onblur="this.style.borderColor='var(--bdr)'"
          />
        </div>
      </div>

      <!-- I am a -->
      <div class="flex flex-col" style="gap:5px">
        <label for="cf-interest" style="font-family:var(--site-font);font-size:11px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:var(--muted)">I am a</label>
        <div class="relative">
          <select
            id="cf-interest"
            name="interest"
            required
            style="font-family:var(--site-font);font-size:14px;color:var(--dark);background:var(--bg1);border:1px solid var(--bdr);border-radius:6px;height:42px;padding:0 36px 0 12px;width:100%;outline:none;appearance:none;cursor:pointer;transition:border-color 150ms"
            onfocus="this.style.borderColor='var(--green)'"
            onblur="this.style.borderColor='var(--bdr)'"
          >
            <option value="" disabled selected style="color:var(--muted)">Select one</option>
            <option value="developer-builder">Developer / Builder</option>
            <option value="investor-partner">Investor / Partner</option>
            <option value="other">Other</option>
          </select>
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 5L7 9L11 5" stroke="var(--muted)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>

      <!-- Message -->
      <div class="flex flex-col" style="gap:5px">
        <label for="cf-message" style="font-family:var(--site-font);font-size:11px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:var(--muted)">Message</label>
        <textarea
          id="cf-message"
          name="message"
          rows="3"
          placeholder="Tell us about your project or interest"
          style="font-family:var(--site-font);font-size:14px;color:var(--dark);background:var(--bg1);border:1px solid var(--bdr);border-radius:6px;padding:10px 12px;outline:none;resize:none;transition:border-color 150ms;line-height:1.6"
          onfocus="this.style.borderColor='var(--green)'"
          onblur="this.style.borderColor='var(--bdr)'"
        ></textarea>
      </div>

      <!-- Submit -->
      <button type="submit" class="site-btn-p w-full justify-center" style="margin-top:4px">
        Send Message
      </button>
    </form>

  </div>
</div>

<style>
  #contact-panel {
    background: var(--bg1);
    border: 1px solid var(--bdr);
    border-radius: 12px 12px 0 0;
    padding: 32px 28px 36px;
    box-shadow: 0 24px 64px rgba(13,19,16,0.18);
  }
  @media (min-width: 640px) {
    #contact-panel {
      border-radius: 12px;
    }
  }
</style>

<script>
  const modal = document.getElementById('contact-modal');
  const backdrop = document.getElementById('contact-backdrop');
  const closeBtn = document.getElementById('contact-close');

  function openModal() {
    modal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeModal() {
    modal?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-contact-trigger]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });
  });

  backdrop?.addEventListener('click', closeModal);
  closeBtn?.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
